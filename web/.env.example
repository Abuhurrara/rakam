# Origin of the Go API. Server-only — never expose this as NEXT_PUBLIC_.
# next.config.ts rewrites /api/:path* here, so the browser only ever talks
# to the Next.js origin and no CORS config is needed on either side.
#
# Local: whatever PORT is set to in api/.env
# Production: the Render service URL, set as a Vercel environment variable
API_ORIGIN=http://localhost:8091
